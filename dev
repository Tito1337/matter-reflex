#!/usr/bin/env bash
set -euo pipefail

project=$(cd -- "$(dirname -- "$0")" && pwd -P)
idf_image=docker.io/espressif/idf:v5.5.4
matter_image=docker.io/espressif/esp-matter@sha256:c4634244a189eebd315de90bf2719310d1de78da833952e3dcb61c384bebab24
ha_image=localhost/matter-reflex-ha:2026.11.1
# Matter Server 1.5.5, shared by the offline packet test and CI.
controller_image=ghcr.io/matter-js/matterjs-server@sha256:52a3a08f99edafa742d356891515c52a98fc9ffeb9e60fdaca937005f93f3a10
podman_cmd=(podman --cgroup-manager=cgroupfs)
run=(run --rm -i --volume "$project:/work:z" --workdir /work)
if [[ -t 0 && -t 1 ]]; then
    run+=(-t)
fi

mode=${1:-}
if (( $# )); then shift; fi
case "$mode" in
    factory|usb|matter-usb)
        board=${MATTER_REFLEX_BOARD:-$(git -C "$project" config --local --get matter-reflex.board 2>/dev/null || true)}
        if [[ -z "$board" || "$board" != /dev/serial/by-id/* || ! -L "$board" ]]; then
            echo "Select a board in /dev/serial/by-id/ using MATTER_REFLEX_BOARD or git config --local matter-reflex.board. See firmware/README.md." >&2
            exit 1
        fi
        board_name=${board##*/}
        private_board="${XDG_DATA_HOME:-$HOME/.local/share}/matter-reflex/${board_name//:/-}"
        ;;
esac

case "$mode" in
    esphome)
        exec "${podman_cmd[@]}" run --rm -i \
            --volume "$project/examples:/config/examples:z" \
            --volume "$project/components:/config/components:ro,z" \
            --volume "$project/firmware/partitions.csv:/config/firmware/partitions.csv:ro,z" \
            --volume reflex-esphome-cache:/cache --workdir /config \
            ghcr.io/esphome/esphome:2026.11.0 "$@"
        ;;
    factory)
        install -d -m 0700 "$private_board"
        exec "${podman_cmd[@]}" "${run[@]}" --network none --volume "$private_board:/provision:Z" "$matter_image" python /work/tools/factory.py /provision
        ;;
    matter)
        exec "${podman_cmd[@]}" "${run[@]}" --volume matter-reflex-idf-cache:/root/.cache "$matter_image" bash -c 'cd /work && exec "$@"' bash "$@"
        ;;
    idf)
        exec "${podman_cmd[@]}" "${run[@]}" "$idf_image" bash -c 'cd /work && exec "$@"' bash "$@"
        ;;
    usb|matter-usb)
        if [[ ! -c "$board" || ! -r "$board" || ! -w "$board" ]]; then
            echo "Board unavailable. Check the USB connection and serial port permissions. See firmware/README.md." >&2
            exit 1
        fi
        if [[ $mode == matter-usb ]]; then
            idf_image=$matter_image
            if [[ -d "$private_board/factory" ]]; then
                run+=(--volume "$private_board/factory:/factory:ro,Z")
            fi
        fi
        device=$(readlink -f -- "$board")
        # Rootless crun can retain dialout (or the distribution’s serial group).
        if [[ $("${podman_cmd[@]}" info --format '{{.Host.OCIRuntime.Name}}') == crun ]]; then
            run+=(--group-add keep-groups)
        fi
        exec "${podman_cmd[@]}" "${run[@]}" --device "$device" --env "ESPPORT=$device" --env "ESPTOOL_PORT=$device" "$idf_image" bash -c 'cd /work && exec "$@"' bash "$@"
        ;;
    lab)
        if [[ ${1:-} == smoke ]]; then
            exec "${podman_cmd[@]}" run --rm --network none --volume "$project/tests/lab:/app/reflex-lab:ro,z" \
                --entrypoint node "$controller_image" /app/reflex-lab/smoke.mjs
        fi
        export REFLEX_LAB_IMAGE="$controller_image" REFLEX_LAB_HA_IMAGE="$ha_image"
        if [[ ${1:-} == takeover ]]; then
            export REFLEX_LAB_IDF_IMAGE="$idf_image" REFLEX_LAB_MATTER_IMAGE="$matter_image"
            mkdir -p "$project/firmware/build/reflex-lab"
            # The two emulators read the build products throughout the run.
            exec 9>"$project/firmware/build/reflex-lab/run.lock"
            flock 9
            "${podman_cmd[@]}" build -f "$project/tools/Containerfile.ha" -t "$ha_image" "$project/tools"
            (cd "$project" && tests/lab/c6/prepare)
        fi
        exec python3 "$project/tests/lab/lab.py" "$@"
        ;;
    test-sensors)
        scratch=$(mktemp -d)
        trap 'rm -rf -- "$scratch"' EXIT
        "$project/dev" ha python - < "$project/tests/contract/sensor-image.py" > "$scratch/image"
        sources=( -std=c++17 -static -Icomponents/matter_reflex components/matter_reflex/reflex_engine.cpp tests/contract/sensor-driver.cpp )
        if command -v g++ >/dev/null; then
            (cd "$project" && g++ "${sources[@]}" -o "$scratch/engine")
        else
            "${podman_cmd[@]}" "${run[@]}" --network none --volume "$scratch:/fixture:Z" "$idf_image" \
                g++ "${sources[@]}" -o /fixture/engine
        fi
        chmod a+rx "$scratch" "$scratch/engine"
        chmod a+r "$scratch/image"
        "${podman_cmd[@]}" run --rm -i --network none --volume "$scratch:/fixture:ro,Z" --entrypoint node \
            "$controller_image" --input-type=module < "$project/tests/contract/sensor-outage.mjs"
        ;;
    test-lease)
        exec "${podman_cmd[@]}" run --rm -i --network none --entrypoint node "$controller_image" \
            --input-type=module < "$project/tests/contract/lease-exchange.mjs"
        ;;
    ha)
        exec "${podman_cmd[@]}" "${run[@]}" --network none --entrypoint "" "$ha_image" "$@"
        ;;
    *)
        echo "Usage: ./dev {esphome|matter|matter-usb|factory|idf|usb|ha|lab|test-lease|test-sensors} command [arguments...]" >&2
        exit 2
        ;;
esac
