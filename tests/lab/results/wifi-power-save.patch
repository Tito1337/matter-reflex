--- /dev/null
+++ b/tests/lab/bench.py
@@ -0,0 +1,46 @@
+import json
+import random
+import time
+
+def measure(board, call, reflex, eventually):
+    blocks = ("L", "N", "N", "L")
+    def count():
+        return len(call("targets", "bench-commands"))
+    def press():
+        before = len(call("button", "bench-events"))
+        previous = count()
+        call("targets", "reset")
+        call("button", "double")
+        def receipt():
+            commands = call("targets", "bench-commands")[previous:]
+            if not commands:
+                return None
+            assert len(commands) == 1 and commands[0]["sender"] == reflex and commands[0]["command"] == "on", commands
+            return commands[0]["us"]
+        stop = eventually(receipt, "single authenticated lamp ON", timeout=20)
+        start = call("button", "bench-events")[before:]
+        assert len(start) == 1 and stop >= start[0], (start, stop)
+        assert call("targets", "snapshot") == {"commands":[{"sender": reflex, "command":"on"}], "on":True, "tilt":0}
+        return (stop-start[0])/1000
+    for b, mode in enumerate(blocks):
+        ack = board.run / "bench-ack"
+        ack.unlink(missing_ok=True)
+        req = board.run / "bench-req.new"
+        req.write_text(mode)
+        req.replace(board.run / "bench-req")
+        seen = eventually(lambda: ack.read_text() if ack.exists() else None, "guest power mode readback",timeout=45)
+        expected = 1 if mode == "L" else 0
+        assert seen == f"{mode} {expected} {expected} 0 0", seen
+        print(f"Block {b+1} guest readback {seen}", flush=True)
+        time.sleep(2)
+        press()
+        gap = random.Random(42)
+        for i in range(10):
+            time.sleep(gap.uniform(.1,.7))
+            ms = press()
+            row = {"block":b+1, "mode":mode, "sample":i+1, "ms":ms}
+            print("SAMPLE " + json.dumps(row),flush=True)
+        time.sleep(1)
+        assert count() == (b+1)*11
+    assert len(call("button", "bench-events")) == 44
+    print("BENCH COMPLETE", flush=True)
