diff --git a/firmware/main/study.cpp b/firmware/main/study.cpp
new file mode 100644
--- /dev/null
+++ b/firmware/main/study.cpp
@@ -0,0 +1,81 @@
+#include <initializer_list>
+#include "study.h"
+#include <nvs.h>
+#include <esp_log.h>
+#include <esp_partition.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <openthread/platform/settings.h>
+#include <cstring>
+
+int study_mode;
+static nvs_handle_t store;
+static bool hid_role;
+static TaskHandle_t counted_task;
+static unsigned writes, erases;
+extern "C" otError __real_otPlatSettingsGet(otInstance *,uint16_t,int,uint8_t *,uint16_t *);
+extern "C" otError __wrap_otPlatSettingsGet(otInstance *ot,uint16_t key,int index,uint8_t *data,uint16_t *length) {
+    auto error=__real_otPlatSettingsGet(ot,key,index,data,length);
+    if (error==OT_ERROR_NONE && key==OT_SETTINGS_KEY_NETWORK_INFO && data && length && *length>=4 && !hid_role && (study_mode & 1)) {
+        // Pinned NetworkInfo: leave identity and anti-replay counters intact.
+        // Invalid short address exercises the SDK's normal full-attach path.
+        data[2]=data[3]=0xff;
+        hid_role=true;
+        ESP_LOGI("study","saved locator withheld");
+    }
+    return error;
+}
+extern "C" esp_err_t __real_esp_partition_write(const esp_partition_t*,size_t,const void*,size_t);
+extern "C" esp_err_t __wrap_esp_partition_write(const esp_partition_t *p,size_t o,const void *d,size_t n) {
+    auto e=__real_esp_partition_write(p,o,d,n);
+    if(e==ESP_OK && counted_task==xTaskGetCurrentTaskHandle() && strcmp(p->label,"nvs")==0) ++writes;
+    return e;
+}
+extern "C" esp_err_t __real_esp_partition_erase_range(const esp_partition_t*,size_t,size_t);
+extern "C" esp_err_t __wrap_esp_partition_erase_range(const esp_partition_t *p,size_t o,size_t n) {
+    auto e=__real_esp_partition_erase_range(p,o,n);
+    if(e==ESP_OK && counted_task==xTaskGetCurrentTaskHandle() && strcmp(p->label,"nvs")==0) erases+=n/4096;
+    return e;
+}
+void study_init(){
+    ESP_ERROR_CHECK(nvs_open("study",NVS_READWRITE,&store));
+    int32_t m=0;
+    nvs_get_i32(store,"next",&m);
+    study_mode=m;
+    ESP_LOGI("study","mode=%d",study_mode);
+}
+void study_set(int m){
+    if(m==99) return;
+    ESP_ERROR_CHECK(nvs_set_i32(store,"next",m));
+    ESP_ERROR_CHECK(nvs_commit(store));
+}
+bool study_load(ButtonRecord &s){
+    size_t len=sizeof(s);
+    return nvs_get_blob(store,"source",&s,&len)==ESP_OK && len==sizeof(s);
+}
+void study_save(const ButtonRecord &s){
+    ButtonRecord old{};
+    if(study_load(old) && !memcmp(&old,&s,sizeof(s))) return;
+    ESP_ERROR_CHECK(nvs_set_blob(store,"source",&s,sizeof(s)));
+    ESP_ERROR_CHECK(nvs_commit(store));
+    ESP_LOGI("study","subscription commit");
+}
+bool study_cursor(uint64_t &n){return nvs_get_u64(store,"cursor",&n)==ESP_OK;}
+void study_commit_cursor(uint64_t n){
+    ESP_ERROR_CHECK(nvs_set_u64(store,"cursor",n));
+    ESP_ERROR_CHECK(nvs_commit(store));
+    ESP_LOGI("study","cursor commit=%llu",(unsigned long long)n);
+}
+void study_wear(){
+    for(unsigned stride: {1u,4u}) {
+        writes=erases=0;
+        counted_task=xTaskGetCurrentTaskHandle();
+        for(unsigned i=stride;i<=2048;i+=stride){
+            ESP_ERROR_CHECK(nvs_set_u64(store,"wear",uint64_t(i)));
+            ESP_ERROR_CHECK(nvs_commit(store));
+        }
+        counted_task=nullptr;
+        ESP_LOGI("study","wear stride=%u events=2048 commits=%u writes=%u erased4k=%u",stride,2048/stride,writes,erases);
+    }
+}
+
