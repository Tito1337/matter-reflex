diff --git a/tests/lab/persistence_study.py b/tests/lab/persistence_study.py
new file mode 100644
--- /dev/null
+++ b/tests/lab/persistence_study.py
@@ -0,0 +1,151 @@
+"""Cold-start experiments on one disposable fabric, with the HA controller offline."""
+import json
+import re
+import time
+from pathlib import Path
+from lab import podman
+from c6 import boot_milestones
+
+def run(board, reflex, peer_call, prefix):
+    log = board.run / "board.log"
+    out = Path(__file__).resolve().parents[2] / "observations.jsonl"
+    def wait(fn, timeout, what):
+        until = time.monotonic() + timeout
+        while time.monotonic() < until:
+            if value := fn():
+                return value
+            time.sleep(.05)
+        raise RuntimeError("timeout "+what)
+    def mode(value):
+        ack = board.run / "study-ack"
+        ack.unlink(missing_ok=True)
+        (board.run / "study-next").write_text(str(value))
+        wait(lambda: ack.exists() and ack.read_text()==str(value), 180 if value==99 else 12, "mode acknowledgement")
+    def record(row):
+        with out.open("a") as f: print(json.dumps(row),file=f)
+        print("STUDY",json.dumps(row),flush=True)
+    def lines():
+        with log.open("rb") as f:
+            f.seek(offset)
+            return f.read()
+    def cmds():
+        state=peer_call("targets","snapshot")
+        for c in state["commands"]:
+            assert c=={"sender":reflex,"command":"on"},c
+        if state["commands"]: assert state["on"],state
+        return len(state["commands"])
+    def fresh():
+        return len(set(re.findall(rb"study: sub node=(\d+)",lines())))==2
+    tests=[
+        ("warm",0),("no_locator",1),("warm",0),("no_locator",1),("warm",0),("no_locator",1),
+        ("dns",8),("warm",0),("dns",8),
+        ("restore",2),("restore",2),("restore-5s",2),("restore-while-off",2),
+        ("sleep8",0),("sleep8-restore",2),
+        ("early-control",32),("early-on",36),("early-control",32),("early-on",36),
+        ("per-event",0),("batch4",16),("readback",0),
+    ]
+    import os
+    selection=os.environ.get("REFLEX_STUDY_ONLY")
+    if selection in ("timed","recheck"):
+        tests=[t for _ in range(5) for t in (("timed-fresh",0),("timed-restore",2),("timed-restore-early",6))]
+        tests.extend([("expired",2),("idle-restore",2)])
+        if selection=="recheck": tests=[("timed-restore",2)]*3
+    elif selection: tests=[t for t in tests if t[0] in selection.split(",")]
+    for name,flag in tests:
+        mode(flag)
+        board.power_off()
+        off=time.monotonic()
+        offset=log.stat().st_size
+        peer_call("targets","reset")
+        if name=="expired":
+            assert peer_call("button","expire "+reflex)["closed"]==1
+        if name=="restore-while-off":
+            peer_call("button","double")
+        asleep=name.startswith("sleep8")
+        if asleep: podman("kill","--signal","STOP",prefix+"button")
+        if name=="restore-5s": time.sleep(5)
+        start=time.monotonic()
+        result={"series":selection or "matrix","trial":name,"confirmed_off_s":round(start-off,3)}
+        try:
+            board.power_on()
+            if asleep:
+                time.sleep(8)
+                podman("kill","--signal","CONT",prefix+"button")
+                asleep=False
+                peer_call("button","double")
+                time.sleep(.7)
+                result["wake_press_count"]=cmds()
+            if name.startswith("timed-"):
+                wait(lambda: len(set(re.findall(rb"study: case node=(\d+)",lines())))==2,60,"CASE at both peers")
+                result["press_s"]=round(time.monotonic()-start,3)
+                peer_call("button","double")
+                deadline=time.monotonic()+2
+                while time.monotonic()<deadline and not cmds(): time.sleep(.05)
+                result["first_press_count"]=cmds()
+                if not result["first_press_count"]:
+                    if flag & 2 and b"old subscription delivered" in lines():
+                        wait(lambda: b"study: sub node=" in lines(),60,"target subscription")
+                    else:
+                        wait(fresh,60,"fresh source and target")
+                    peer_call("button","double")
+                wait(lambda:cmds()==1,15,"exactly one authenticated On")
+                received_ns=int(peer_call("targets","first-on")["ns"])
+                result["first_receipt_s"]=round(received_ns/1e9-start,3)
+            elif flag & 2:
+                if name=="idle-restore":
+                    wait(fresh,60,"fallback without user input")
+                    assert cmds()==0
+                    result["quiet_until_fallback"]=True
+                wait(lambda:b"listening id=" in lines(),70,"restore listener")
+                wait(lambda: b"study: sub node=" in lines(),60,"target subscription")
+                result["before_fresh"]=cmds()
+                peer_call("button","double")
+                time.sleep(1)
+                result["before_fallback_count"]=cmds()
+                if b"old subscription delivered" not in lines():
+                    wait(fresh,90,"fresh subscription fallback")
+                    before=cmds()
+                    peer_call("button","double")
+                    wait(lambda:cmds()==before+1,10,"fresh press after fallback")
+            elif flag & 32:
+                wait(lambda: b"target subscription held" in lines() and b"subscription commit" in lines(),90,"source and target CASE")
+                peer_call("button","double")
+                time.sleep(.7)
+                result["during_hold"]=cmds()
+                wait(fresh,30,"target subscription completion")
+                before=cmds()
+                peer_call("button","double")
+                wait(lambda:cmds()==before+1,10,"post-hold command")
+            else:
+                wait(fresh,100,"two subscriptions")
+                result["before_fresh"]=cmds()
+                n=7 if name in ("per-event","batch4") else 1
+                for _ in range(n):
+                    before=cmds()
+                    peer_call("button","double")
+                    wait(lambda:cmds()==before+1,12,"fresh command")
+            result["wall_s"]=round(time.monotonic()-start,3)
+            time.sleep(.8)
+            result["receipts"]=cmds()
+            d=lines()
+            result.update(boot_milestones(d.splitlines()))
+            result["notes"]=[m.decode() for m in re.findall(rb"study: ([^\r\n]+)",d)]
+            result["sigma2_resume"]=d.count(b"Msg RX") and len(re.findall(rb"Msg RX[^\n]*CASE_Sigma2Resume\)",d))
+            result["source_sub_requests"]=len(re.findall(rb"Msg TX[^\n]*:5570\][^\n]*IM:SubscribeRequest",d))
+            roles=re.findall(rb"Role detached -> (child|router|leader)",d)
+            result["attached_role"]=roles[0].decode() if roles else None
+            result["old_session_drops"]=d.count(b"Data received on an unknown session")
+            result["stages"]=[(int(m[0]),m[1].decode()) for m in re.findall(rb"I\s*\(\s*(\d+)\) study: ((?:case |sub |action |listening|target subscription held)[^\r\n]*)",d)]
+            record(result)
+        except (RuntimeError, AssertionError) as exc:
+            d=lines()
+            result.update(boot_milestones(d.splitlines()))
+            result["error"]=str(exc)
+            result["notes"]=[m.decode() for m in re.findall(rb"study: ([^\r\n]+)",d)]
+            record(result)
+        finally:
+            if asleep: podman("kill","--signal","CONT",prefix+"button")
+    if selection in ("timed","recheck"): return
+    offset=log.stat().st_size
+    mode(99)
+    record({"wear":[m.decode() for m in re.findall(rb"study: (wear [^\r\n]+)",lines())]})
