+from pathlib import Path
+import hashlib, os
+p=Path(os.environ['ESP_MATTER_PATH'])/'connectedhomeip/connectedhomeip/src/app/ReadClient.h'
+assert hashlib.sha256(p.read_bytes()).hexdigest()=='70e1b27dca57b8568e794a49be5bd099966c81aa69a45e104efb9d793c1f57f1'
+s=p.read_text().replace('    auto GetSubscriptionId() const','''    // Disposable lab, restore the listener on a newly authenticated CASE session.
+    CHIP_ERROR StudyResume(const SessionHandle &session, SubscriptionId id, uint16_t min, uint16_t max)
+    {
+        VerifyOrReturnError(IsIdle() && IsSubscriptionType() && session->IsSecureSession() &&
+            session->AsSecureSession()->IsCASESession(), CHIP_ERROR_INCORRECT_STATE);
+        VerifyOrReturnError(mReadPrepareParams.mSessionHolder.Grab(session), CHIP_ERROR_INCORRECT_STATE);
+        mPeer = session->AsSecureSession()->GetPeer();
+        mSubscriptionId = id;
+        mMinIntervalFloorSeconds = min;
+        mMaxInterval = max;
+        mWaitingForFirstPrimingReport = false;
+        MoveToState(ClientState::SubscriptionActive);
+        return RefreshLivenessCheckTimer();
+    }
+    auto GetSubscriptionId() const''')
+p.write_text(s)
+
