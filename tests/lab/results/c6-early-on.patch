--- /dev/null
+++ b/tests/lab/early_on_study.py
@@ -0,0 +1,122 @@
+"""Isolated cold-boot comparison using normal Matter subscriptions."""
+import json
+import os
+import re
+import time
+from pathlib import Path
+
+
+def wait(check, seconds, description):
+    until = time.monotonic() + seconds
+    while time.monotonic() < until:
+        if value := check():
+            return value
+        time.sleep(0.04)
+    raise TimeoutError(description)
+
+
+def run(board, reflex, peer_call, prefix):
+    log = board.run / "board.log"
+    output = Path(__file__).resolve().parents[2] / "early-results.jsonl"
+    schedule = []
+    for pair in range(12):
+        order = (0, 1) if pair % 2 == 0 else (1, 0)
+        schedule.extend((pair + 1, "ordinary", flag, "double") for flag in order)
+    for pair in range(4):
+        order = (2, 3) if pair % 2 == 0 else (3, 2)
+        schedule.extend((pair + 1, "delayed", flag, "double") for flag in order)
+    schedule.extend([(1, "other-command", 3, "long"), (2, "other-command", 3, "long"),
+                     (1, "while-off", 0, "double"), (1, "while-off", 1, "double")])
+
+    if os.environ.get("REFLEX_EARLY_SERIES") == "source":
+        schedule = [(3, "other-command", 3, "long"), (4, "other-command", 3, "long")]
+        for pair in range(3):
+            order = (2, 3) if pair % 2 == 0 else (3, 2)
+            schedule.extend((pair + 5, "delayed", flag, "double") for flag in order)
+        for pair in range(8):
+            order = (0, 1) if pair % 2 == 0 else (1, 0)
+            schedule.extend((pair + 1, "source-ready", flag, "double") for flag in order)
+
+    def snapshot():
+        return peer_call("targets", "snapshot")
+
+    def verify(state, commands):
+        assert state["commands"] == commands, state
+        assert state["on"] == any(cmd["command"] == "on" for cmd in commands), state
+
+    on = {"command": "on", "sender": reflex}
+    for pair, scenario, flag, gesture in schedule:
+        ack = board.run / "study-ack"
+        ack.unlink(missing_ok=True)
+        (board.run / "study-next").write_text(str(flag))
+        wait(lambda: ack.exists() and ack.read_text() == str(flag), 15, "mode acknowledgement")
+        board.power_off()
+        offset = log.stat().st_size
+
+        def lines():
+            with log.open("rb") as stream:
+                stream.seek(offset)
+                return stream.read()
+
+        def both(stage):
+            data = lines()
+            return all(b"early: " + stage + b" " + peer in data for peer in (b"button", b"target"))
+
+        peer_call("targets", "reset")
+        if scenario == "while-off":
+            peer_call("button", "double")
+        start = time.monotonic_ns()
+        row = dict(pair=pair, scenario=scenario, early=bool(flag & 1), gesture=gesture)
+        row["fabric"] = 2 if os.environ.get("REFLEX_EARLY_SERIES") == "source" else 1
+        try:
+            board.power_on()
+            if scenario != "source-ready":
+                wait(lambda: both(b"case"), 75, "both authenticated peer sessions")
+            if scenario in ("delayed", "other-command", "source-ready"):
+                wait(lambda: b"early: sub button" in lines(), 45, "button subscribed")
+            if scenario == "while-off":
+                wait(lambda: both(b"sub"), 75, "fresh subscriptions after offline press")
+                time.sleep(.8)
+                verify(snapshot(), [])
+            row["gesture_start_s"] = round((time.monotonic_ns() - start) / 1e9, 3)
+            peer_call("button", gesture)
+            wait(lambda: both(b"sub"), 75, "both fresh subscriptions")
+            time.sleep(1.5)
+            state = snapshot()
+            commands = state["commands"]
+            row["first_count"] = len(commands)
+            if gesture == "double":
+                assert len(commands) <= 1
+                verify(state, [on] if commands else [])
+                if commands:
+                    received = int(peer_call("targets", "first-on")["ns"])
+                    row["first_on_s"] = round((received - start) / 1e9, 3)
+            before_second = lines()
+            if gesture == "long":
+                match = re.search(rb"early: action op=10 subscribed=([01]) active=1", before_second)
+                assert match, "the long press must match the cover rule"
+                if match[1] == b"0":
+                    verify(state, [])
+                else:
+                    assert len(commands) == 1 and commands[0]["command"] == "tilt"
+                    assert commands[0]["sender"] == reflex
+            assert f"early: mode={flag}".encode() in before_second
+            row["first_stages_ms"] = [
+                [int(ms), label.decode()] for ms, label in re.findall(
+                    rb"I\s*\(\s*(\d+)\) early: ([^\r\n]+)", before_second
+                )
+            ]
+            for port, peer in [(5570, "button"), (5571, "target")]:
+                calls = re.findall(rb"Msg TX[^\n]*:" + str(port).encode() + rb"\][^\n]*IM:SubscribeRequest", before_second)
+                row[peer + "_subscribe_requests"] = len(calls)
+                assert calls, peer + " had no fresh SubscribeRequest"
+            peer_call("button", "double")
+            wait(lambda: len(snapshot()["commands"]) > len(commands), 12, "follow-up press")
+            time.sleep(.6)
+            verify(snapshot(), commands + [on])
+            row["follow_up"] = True
+        except (TimeoutError, RuntimeError, AssertionError) as exc:
+            row["error"] = repr(exc)
+        with output.open("a") as stream:
+            print(json.dumps(row), file=stream)
+        print("EARLY", json.dumps(row), flush=True)
