#!/usr/bin/env bash
# Read a Python-compiled rule image on stdin. Build only temporary host binaries.
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
build_dir=$(mktemp -d)
trap 'rm -rf -- "$build_dir"' EXIT
flags=(-Icomponents/matter_reflex -std=c++17 -Wall -Wextra -Werror -fsanitize=undefined -fno-sanitize-recover=all)
for source in tests/engine_test.cpp tests/contract/decode.cpp; do
    g++ "${flags[@]}" components/matter_reflex/reflex_engine.cpp "$source" -o "$build_dir/test"
    "$build_dir/test"
done
g++ "${flags[@]}" firmware/tests/lease_deadline_test.cpp -o "$build_dir/lease-test"
"$build_dir/lease-test"
