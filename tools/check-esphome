#!/usr/bin/env bash
# Build a checkout with disposable credentials. All outputs live in a private fixture.
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
mode=${1:-config}
profile=${2:-extend-node}
case "$mode" in config|compile) ;; *) echo "Expected config or compile" >&2; exit 2;; esac
case "$profile" in extend-node|xiao-esp32c6|xiao-esp32c6-ota|xiao-esp32c6-existing-ota) ;;
    *) echo "Expected extend-node, xiao-esp32c6, xiao-esp32c6-ota or xiao-esp32c6-existing-ota" >&2; exit 2;;
esac

umask 077
mkdir -p examples/.esphome
scratch=$(mktemp -d examples/.esphome/check.XXXXXXXX)
trap 'rm -rf -- "$scratch"' EXIT
mkdir "$scratch/examples"
cp -R examples/demo_components "$scratch/examples/"
ln -s ../../../components "$scratch/components"
ln -s ../../../firmware "$scratch/firmware"
cp examples/{reflex,xiao-base,encrypted-api,ota,xiao-esp32c6-managed,xiao-esp32c6-existing}.yaml \
    examples/partitions-ota.csv "examples/$profile.yaml" "$scratch/examples"

# Public sample from the ESPHome OpenThread documentation.
dataset=0e080000000000010000000300001035060004001fffe00208e227ac6a7f24052f0708fdb753eb517cb4d3051062b2442a928d9ea3b947a1618fc4085a030f4f70656e5468726561642d393837330102987304105330d857354330133c05e1fd7ae81a910c0402a0f7f8
key=$(head -c 32 /dev/urandom | base64)
printf "thread_tlv: '%s'\\nreflex_api_key: '%s'\\n" "$dataset" "$key" > "$scratch/examples/secrets.yaml"
./dev esphome "$mode" "$scratch/examples/$profile.yaml"
