#!/usr/bin/env bash
# Build a checkout with disposable credentials. All outputs live in a private fixture.
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
mode=${1:-config}
profile=${2:-extend-node}
case "$mode" in config|compile) ;; *) echo "Expected config or compile" >&2; exit 2;; esac
case "$profile" in extend-node|xiao-esp32c6|xiao-esp32c6-ota|xiao-esp32c6-existing-ota|thread|wifi|combined) ;;
    *) echo "Unknown ESPHome test profile" >&2; exit 2;;
esac

umask 077
mkdir -p examples/.esphome
scratch=$(mktemp -d examples/.esphome/check.XXXXXXXX)
trap 'rm -rf -- "$scratch"' EXIT
mkdir "$scratch/examples"
cp -R examples/network examples/demo_components "$scratch/examples/"
ln -s ../../../components "$scratch/components"
ln -s ../../../firmware "$scratch/firmware"
cp examples/{reflex,xiao-base,xiao-networks,encrypted-api,ota,xiao-esp32c6-managed,xiao-esp32c6-existing}.yaml \
    examples/partitions-ota.csv "$scratch/examples"

dataset=$(python3 tests/lab/c6/dataset.py)
key=$(head -c 32 /dev/urandom | base64)
if [[ $profile != wifi ]]; then
    printf "thread_tlv: '%s'\n" "$dataset" > "$scratch/examples/secrets.yaml"
fi
printf "reflex_api_key: '%s'\n" "$key" >> "$scratch/examples/secrets.yaml"
case "$profile" in
    thread|wifi|combined)
        cat > "$scratch/examples/$profile.yaml" <<'YAML'
packages:
  reflex: !include xiao-networks.yaml
substitutions:
  reflex_api_key: !secret reflex_api_key
YAML
        if [[ $profile != thread ]]; then
            printf '  reflex_wifi_ssid: !secret wifi_ssid\n  reflex_wifi_password: !secret wifi_password\n' >> "$scratch/examples/$profile.yaml"
            printf 'wifi_ssid: "12345678"\nwifi_password: "01234567"\n' >> "$scratch/examples/secrets.yaml"
        fi
        if [[ $profile != wifi ]]; then
            echo '  reflex_thread_tlv: !secret thread_tlv' >> "$scratch/examples/$profile.yaml"
        fi
        ;;
    *) cp "examples/$profile.yaml" "$scratch/examples/";;
esac
reject_config() {
    if ./dev esphome config "$scratch/examples/incomplete.yaml" > "$scratch/validation.log" 2>&1; then
        echo "Accepted a configuration with $1" >&2
        exit 1
    fi
    grep -Fq "$2" "$scratch/validation.log" || {
        echo "Unexpected failure while validating a configuration with $1" >&2
        exit 1
    }
}
if [[ $profile == wifi || $profile == combined ]]; then
    for missing in ssid password; do
        sed "/^  reflex_wifi_$missing:/d" "$scratch/examples/$profile.yaml" > "$scratch/examples/incomplete.yaml"
        reason="SSID can't be empty"
        if [[ $missing == password ]]; then reason="WPA password must be at least 8 characters long"; fi
        reject_config "missing $missing" "$reason"
    done
fi
if [[ $profile == wifi ]]; then
    sed '/^  reflex_wifi_/d' "$scratch/examples/$profile.yaml" > "$scratch/examples/incomplete.yaml"
    reject_config "no network" "Matter Reflex requires OpenThread or a Wi-Fi station network"
fi
./dev esphome "$mode" "$scratch/examples/$profile.yaml"
